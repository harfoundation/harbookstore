# Supabase (local dev values printed by `supabase start`; replace with cloud project values in Vercel for staging/prod)
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Resend (transactional email)
RESEND_API_KEY=
RESEND_FROM_EMAIL="山书房 Har Bookstore <no-reply@harfoundation.org.au>"

# Site
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Vercel Cron auth (set in Vercel env vars; Vercel automatically sends this as
# a Bearer token when invoking cron routes in production)
CRON_SECRET=
