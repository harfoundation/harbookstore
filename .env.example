# NOTE: this file documents the Next.js env vars (copy to .env.local).
# The Supabase CLI reads a *separate* root `.env` file (not .env.local, and
# not committed) for env() substitution in supabase/config.toml — that's
# where Google OAuth's SUPABASE_AUTH_EXTERNAL_GOOGLE_CLIENT_ID/SECRET live.
# Restart `supabase start` after changing that file.

# Supabase (local dev values printed by `supabase start`; replace with cloud project values in Vercel for staging/prod)
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Resend (transactional email)
RESEND_API_KEY=
RESEND_FROM_EMAIL="山書坊 Har Book Club <no-reply@harfoundation.org.au>"

# Site
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# WhatsApp contact number (E.164, no spaces/dashes) — wa.me deep-link only for
# now, no Business API integration. This number is publicly visible on the
# site, so it's safe to have here even though it's NEXT_PUBLIC_.
NEXT_PUBLIC_WHATSAPP_NUMBER=+61449887359

# WhatsApp Community invite link (chat.whatsapp.com/...), shown as a
# "加入 WhatsApp 社群" button across the site. Publicly visible, safe as NEXT_PUBLIC_.
NEXT_PUBLIC_WHATSAPP_COMMUNITY_URL=

# --- WhatsApp Business Cloud API (optional, for automated notifications) ---
# Leave all unset to disable — borrow/order/membership confirmations simply
# skip the WhatsApp send and only use email, matching the Resend pattern.
# Requires a Meta for Developers app with the WhatsApp product, a verified
# business phone number, and at least one approved message template.
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_BUSINESS_ACCOUNT_ID=

# Vercel Cron auth (set in Vercel env vars; Vercel automatically sends this as
# a Bearer token when invoking cron routes in production)
CRON_SECRET=
